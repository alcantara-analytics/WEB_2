{
  "name": "web-2",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "kv_namespaces": [
    {
      "binding": "LISTA_KV",
      "id": "be58d87dce5b483faec4cea893d31b12",
      "remote": true
    }
  ]
}
